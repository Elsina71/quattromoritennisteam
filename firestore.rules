rules_version = '2';

// Regole del database di Quattro Mori Tennis Team.
//
// users/{uid}      profilo: nome, cognome, telefono, email, ruolo. Lo leggono solo la persona stessa e lo staff.
// courts/{id}      campi: nome, tipo, orari. Pubblici; li modifica solo l'admin.
// bookings/{id}    prenotazioni con il nome di chi gioca. Le leggono solo lo staff e chi ha prenotato.
// slots/{id}       una mezz'ora occupata, senza nomi: pubblica, così tutti vedono libero/occupato.
//                  L'id è campo_data_ora: due prenotazioni sulla stessa mezz'ora scriverebbero lo stesso
//                  documento, e la seconda viene rifiutata (le mezz'ore non si sovrascrivono mai).
//
// Staff = admin e segreteria. Il titolare è admin per la sua email (qui c'è solo l'impronta SHA-256).

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    function isOwner() {
      return signedIn()
        && request.auth.token.email_verified == true
        && hashing.sha256(request.auth.token.email.lower()).toHexString().lower()
           == 'a2de6b81796442dad657da768dcb08f740fe60afdbdb368e2f9a1604238913c1';
    }

    function myDoc() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function myRole() { return exists(myDoc()) ? get(myDoc()).data.role : ''; }
    function isAdmin() { return isOwner() || (signedIn() && myRole() == 'admin'); }
    function isStaff() { return isOwner() || (signedIn() && myRole() in ['admin', 'segreteria']); }

    function str(v, max) { return v is string && v.size() <= max; }
    function filled(v, max) { return str(v, max) && v.size() > 0; }
    function isTime(t) { return t is string && t.matches('^([01][0-9]|2[0-4]):(00|30)$'); }
    function hhmm(t) { return int(t[0:2]) * 60 + int(t[3:5]); }

    // ---------- utenti ----------
    function okProfile(d) {
      return d.keys().hasOnly(['first', 'last', 'phone', 'email', 'role', 'lang', 'createdAt'])
        && filled(d.first, 40) && str(d.last, 40) && str(d.phone, 30) && str(d.email, 120)
        && d.role in ['admin', 'segreteria', 'allenatore', 'utente']
        && (!('lang' in d) || d.lang in ['it', 'en']);
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isStaff());

      // ci si registra da soli, sempre come "utente"; solo il titolare nasce admin
      allow create: if signedIn() && request.auth.uid == uid
        && okProfile(request.resource.data)
        && request.resource.data.email == request.auth.token.email
        && (request.resource.data.role == 'utente' || (request.resource.data.role == 'admin' && isOwner()));

      allow update: if signedIn() && okProfile(request.resource.data)
        && request.resource.data.email == resource.data.email
        && (
          // la persona stessa: solo i suoi dati, non il ruolo
          (request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['first', 'last', 'phone', 'lang']))
          // l'admin: tutto, ruoli compresi
          || isAdmin()
          // la segreteria: i dati di utenti e allenatori, non i ruoli
          || (isStaff() && resource.data.role in ['utente', 'allenatore']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['first', 'last', 'phone']))
        );

      allow delete: if isAdmin() || (isStaff() && resource.data.role in ['utente', 'allenatore']);
    }

    // ---------- campi ----------
    match /courts/{id} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'type', 'from', 'to', 'active', 'order'])
        && filled(request.resource.data.name, 40)
        && request.resource.data.type in ['tennis', 'padel']
        && isTime(request.resource.data.from) && isTime(request.resource.data.to)
        && hhmm(request.resource.data.from) < hhmm(request.resource.data.to)
        && request.resource.data.active is bool
        && request.resource.data.order is int;
    }

    // ---------- prenotazioni ----------
    function slotPath(courtId, date, t) {
      return /databases/$(database)/documents/slots/$(courtId + '_' + date + '_' + t[0:2] + t[3:5]);
    }

    match /bookings/{id} {
      allow read: if signedIn() && (isStaff() || resource.data.uid == request.auth.uid);

      // l'utente prenota per sé; lo staff anche per altri o per chi non è registrato (uid vuoto).
      // Nella stessa scrittura devono nascere anche le sue mezz'ore (almeno la prima e l'ultima).
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['courtId', 'date', 'start', 'end', 'last', 'dur', 'uid', 'name', 'createdBy', 'createdAt'])
        && request.resource.data.date is string && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && isTime(request.resource.data.start) && isTime(request.resource.data.end)
        && request.resource.data.dur in [60, 90, 120]
        && hhmm(request.resource.data.end) == hhmm(request.resource.data.start) + request.resource.data.dur
        && filled(request.resource.data.name, 80)
        && request.resource.data.createdBy == request.auth.uid
        && (request.resource.data.uid == null || request.resource.data.uid is string)
        && (isStaff() || request.resource.data.uid == request.auth.uid)
        && exists(/databases/$(database)/documents/courts/$(request.resource.data.courtId))
        && existsAfter(slotPath(request.resource.data.courtId, request.resource.data.date, request.resource.data.start))
        && isTime(request.resource.data.last)
        && hhmm(request.resource.data.last) == hhmm(request.resource.data.end) - 30
        && existsAfter(slotPath(request.resource.data.courtId, request.resource.data.date, request.resource.data.last));

      allow update: if false;
      allow delete: if signedIn() && (isStaff() || resource.data.uid == request.auth.uid);
    }

    // ---------- mezz'ore occupate (da una prenotazione o da un allenamento) ----------
    function slotIn(sid, s, b) {
      return b != null
        && b.data.courtId == s.courtId && b.data.date == s.date
        && isTime(s.time)
        && hhmm(s.time) >= hhmm(b.data.start) && hhmm(s.time) < hhmm(b.data.end)
        && sid == s.courtId + '_' + s.date + '_' + s.time[0:2] + s.time[3:5];
    }
    function bookingSlotOk(sid, s) {
      let b = getAfter(/databases/$(database)/documents/bookings/$(s.bookingId));
      return s.keys().hasOnly(['courtId', 'date', 'time', 'bookingId']) && s.bookingId is string
        && slotIn(sid, s, b) && (isStaff() || b.data.uid == request.auth.uid);
    }
    function trainingSlotOk(sid, s) {
      return s.keys().hasOnly(['courtId', 'date', 'time', 'trainingId']) && s.trainingId is string && isStaff()
        && slotIn(sid, s, getAfter(/databases/$(database)/documents/trainings/$(s.trainingId)));
    }

    match /slots/{sid} {
      allow read: if true;
      allow create: if signedIn()
        && (('bookingId' in request.resource.data && bookingSlotOk(sid, request.resource.data))
          || ('trainingId' in request.resource.data && trainingSlotOk(sid, request.resource.data)));
      allow update: if false;
      allow delete: if signedIn()
        && (isStaff() || ('bookingId' in resource.data
          && get(/databases/$(database)/documents/bookings/$(resource.data.bookingId)).data.uid == request.auth.uid));
    }

    // ---------- corsisti: schede con dati personali e certificato medico, solo staff ----------
    function isDate(d) { return d is string && (d == '' || d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')); }
    match /athletes/{id} {
      allow read, delete: if isStaff();
      allow create, update: if isStaff()
        && request.resource.data.keys().hasOnly(['first', 'last', 'birth', 'phone', 'email', 'parent', 'notes',
             'certType', 'certExpiry', 'fitpPaid', 'fitpYear', 'active', 'createdAt'])
        && filled(request.resource.data.first, 40) && str(request.resource.data.last, 40)
        && isDate(request.resource.data.birth) && str(request.resource.data.phone, 30)
        && str(request.resource.data.email, 120) && str(request.resource.data.parent, 80)
        && str(request.resource.data.notes, 500)
        && request.resource.data.certType in ['', 'agonistico', 'non agonistico']
        && isDate(request.resource.data.certExpiry)
        && request.resource.data.fitpPaid is bool && request.resource.data.fitpYear is int
        && request.resource.data.active is bool;
    }

    // ---------- allenamenti: li crea lo staff, l'allenatore vede i suoi ----------
    function isCoach(t) { return signedIn() && t.data.coachId == request.auth.uid; }
    match /trainings/{id} {
      allow read: if isStaff() || (signedIn() && resource.data.coachId == request.auth.uid);
      allow create: if isStaff()
        && request.resource.data.keys().hasOnly(['title', 'courtId', 'date', 'start', 'end', 'last', 'dur',
             'coachId', 'coachName', 'athleteIds', 'names', 'series', 'notes', 'createdBy', 'createdAt'])
        && filled(request.resource.data.title, 60)
        && request.resource.data.date is string && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && isTime(request.resource.data.start) && isTime(request.resource.data.end)
        && request.resource.data.dur in [60, 90, 120]
        && hhmm(request.resource.data.end) == hhmm(request.resource.data.start) + request.resource.data.dur
        && isTime(request.resource.data.last) && hhmm(request.resource.data.last) == hhmm(request.resource.data.end) - 30
        && request.resource.data.coachId is string && str(request.resource.data.coachName, 80)
        && request.resource.data.athleteIds is list && request.resource.data.athleteIds.size() <= 40
        && request.resource.data.names is map && str(request.resource.data.notes, 500)
        && request.resource.data.createdBy == request.auth.uid
        && exists(/databases/$(database)/documents/courts/$(request.resource.data.courtId))
        && existsAfter(slotPath(request.resource.data.courtId, request.resource.data.date, request.resource.data.start))
        && existsAfter(slotPath(request.resource.data.courtId, request.resource.data.date, request.resource.data.last));
      // si cambiano titolo, allenatore, corsisti e note; per spostare giorno, ora o campo si ricrea
      allow update: if isStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'coachId', 'coachName', 'athleteIds', 'names', 'notes'])
        && filled(request.resource.data.title, 60) && request.resource.data.coachId is string
        && request.resource.data.athleteIds is list && request.resource.data.athleteIds.size() <= 40
        && request.resource.data.names is map && str(request.resource.data.notes, 500);
      allow delete: if isStaff();
    }

    // ---------- valutazioni: id = allenamento_corsista ----------
    function okScore(m, k) { return !(k in m) || (m[k] is int && m[k] >= 1 && m[k] <= 10); }
    function okScores(m) {
      return m is map
        && m.keys().hasOnly(['tecnica', 'movimento', 'controllo', 'scelte', 'intensita', 'atteggiamento', 'consistenza'])
        && okScore(m, 'tecnica') && okScore(m, 'movimento') && okScore(m, 'controllo') && okScore(m, 'scelte')
        && okScore(m, 'intensita') && okScore(m, 'atteggiamento') && okScore(m, 'consistenza');
    }
    match /evals/{id} {
      allow read: if isStaff() || (signedIn() && resource.data.coachId == request.auth.uid);
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['trainingId', 'athleteId', 'athleteName', 'date', 'title', 'coachId', 'scores', 'note', 'by', 'updatedAt'])
        && id == request.resource.data.trainingId + '_' + request.resource.data.athleteId
        && okScores(request.resource.data.scores) && str(request.resource.data.note, 300)
        && str(request.resource.data.athleteName, 80) && str(request.resource.data.title, 60)
        && request.resource.data.by == request.auth.uid
        && (isStaff() || isCoach(get(/databases/$(database)/documents/trainings/$(request.resource.data.trainingId))))
        && request.resource.data.athleteId in get(/databases/$(database)/documents/trainings/$(request.resource.data.trainingId)).data.athleteIds
        && request.resource.data.coachId == get(/databases/$(database)/documents/trainings/$(request.resource.data.trainingId)).data.coachId
        && request.resource.data.date == get(/databases/$(database)/documents/trainings/$(request.resource.data.trainingId)).data.date;
      allow delete: if isStaff() || (signedIn() && resource.data.coachId == request.auth.uid);
    }
  }
}
